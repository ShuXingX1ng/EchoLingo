
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API Backend
# Set to Python FastAPI backend URL
# Example: http://localhost:8000 or https://api.echolingo.com
NEXT_PUBLIC_API_BASE_URL=

# Developer switch: Read Aloud also runs Azure on the same recording as a
# comparison baseline (Speech Evaluation Mode `compare`). Leave unset for the
# EchoLingo-only default.
NEXT_PUBLIC_SPEECH_EVALUATION_COMPARE=
