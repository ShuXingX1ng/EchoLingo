# EchoLingo Backend Environment Variables

# =============================================================================
# LLM Configuration (DeepSeek/OpenAI compatible)
# =============================================================================
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# =============================================================================
# Azure Speech Services
# =============================================================================
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# =============================================================================
# Supabase Configuration
# =============================================================================
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# RAG Vector Store (Phase RAG-3)
# =============================================================================
# Alibaba DashScope embeddings (text-embedding-v4, OpenAI-compatible API).
# Required by services/vector_store.py and scripts/seed_rubrics.py.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Optional — defaults to the public compatible-mode endpoint.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Postgres connection string for the Supabase pgvector store (used by `vecs`).
# Found in Supabase dashboard → Project Settings → Database → Connection string.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# =============================================================================
# Study Assistant — GNews (news-grounded practice generation)
# =============================================================================
# Optional. Without this key, the Study Assistant falls back to the Exemplar
# path when the learner requests news-grounded practice (per ADR-0007).
GNEWS_API_KEY=

# =============================================================================
# Server Configuration
# =============================================================================
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Server host and port
HOST=0.0.0.0
PORT=8000
